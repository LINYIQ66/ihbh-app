diff --git a/tests/actor.test.mjs b/tests/actor.test.mjs
new file mode 100644
index 0000000..d8c0bc1
--- /dev/null
+++ b/tests/actor.test.mjs
@@ -0,0 +1,127 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import vm from "node:vm";
+import ts from "typescript";
+const source = fs.readFileSync(
+  new URL("../base44/actors/LiveBroadcast/entry.ts", import.meta.url),
+  "utf8",
+);
+const js = ts.transpileModule(
+  source
+    .replace("import { Actor } from 'base44:runtime/actors';", "")
+    .replace(
+      "export default class LiveBroadcast",
+      "globalThis.LiveBroadcast = class LiveBroadcast",
+    ),
+  {
+    compilerOptions: {
+      target: ts.ScriptTarget.ES2022,
+      module: ts.ModuleKind.None,
+    },
+  },
+).outputText;
+function setup() {
+  const room = { id: "room", host_user_id: "owner", status: "ended" },
+    sent = [];
+  let banned = false;
+  class Actor {
+    instanceId = "room";
+    storage = { get: async () => null, put: async () => {} };
+    client = {
+      asServiceRole: {
+        entities: {
+          LiveRoom: {
+            get: async () => ({ ...room }),
+            update: async (_, v) => Object.assign(room, v),
+          },
+          LiveBan: { count: async () => (banned ? 1 : 0) },
+        },
+      },
+    };
+    broadcast(m) {
+      sent.push(m);
+    }
+    getConnections() {
+      return connections;
+    }
+  }
+  const connections = [];
+  const context = vm.createContext({ Actor, Map, Set, Date, Promise, console });
+  vm.runInContext(js, context);
+  const actor = new context.LiveBroadcast();
+  const connect = async (id, uid) => {
+    const conn = {
+      id,
+      identity: { type: "authenticated", userId: uid },
+      send: (m) => sent.push(m),
+      reject: () => {
+        conn.rejected = true;
+      },
+    };
+    connections.push(conn);
+    await actor.handleConnect(conn);
+    return conn;
+  };
+  return {
+    actor,
+    room,
+    sent,
+    connect,
+    ban: () => {
+      banned = true;
+    },
+  };
+}
+test("actor denies forged ownership and wrong instance IDs", async () => {
+  const s = setup(),
+    other = await s.connect("x", "intruder");
+  await s.actor.handleMessage(other, {
+    type: "host_start",
+    registryId: "room",
+  });
+  assert.equal(s.room.status, "ended");
+  const owner = await s.connect("h", "owner");
+  await s.actor.handleMessage(owner, {
+    type: "host_start",
+    registryId: "another-room",
+  });
+  assert.equal(s.room.status, "ended");
+});
+test("actor denies banned starts and ends an active ban on its managed tick", async () => {
+  const s = setup(),
+    owner = await s.connect("h", "owner");
+  await s.actor.handleMessage(owner, {
+    type: "host_start",
+    registryId: "room",
+  });
+  assert.equal(s.room.status, "live");
+  s.ban();
+  await s.actor.handleTick();
+  assert.equal(s.room.status, "ended");
+  assert.equal(s.actor.hostSeat, null);
+  await s.actor.handleMessage(owner, {
+    type: "host_start",
+    registryId: "room",
+  });
+  assert.equal(s.room.status, "ended");
+});
+test("actor rejects reconnecting a connection id with a different identity", async () => {
+  const s = setup();
+  await s.connect("same", "owner");
+  const intruder = await s.connect("same", "intruder");
+  assert.equal(intruder.rejected, true);
+});
+test("concurrent host starts admit one host", async () => {
+  const s = setup(),
+    a = await s.connect("a", "owner"),
+    b = await s.connect("b", "owner");
+  await Promise.all([
+    s.actor.handleMessage(a, { type: "host_start", registryId: "room" }),
+    s.actor.handleMessage(b, { type: "host_start", registryId: "room" }),
+  ]);
+  assert.equal(
+    [...s.actor.users.values()].filter((u) => u.role === "host").length,
+    1,
+  );
+});
diff --git a/tests/database.mjs b/tests/database.mjs
new file mode 100644
index 0000000..cd415d2
--- /dev/null
+++ b/tests/database.mjs
@@ -0,0 +1,100 @@
+import assert from "node:assert/strict";
+const copy = (v) => structuredClone(v);
+function matches(row, q) {
+  return Object.entries(q).every(([k, v]) => {
+    if (k === "$or") return v.some((x) => matches(row, x));
+    if (k === "$and") return v.every((x) => matches(row, x));
+    const a = row[k];
+    if (v && typeof v === "object" && !Array.isArray(v))
+      return Object.entries(v).every(([op, b]) => {
+        if (op === "$exists") return (a !== undefined) === b;
+        if (op === "$in") return b.includes(a);
+        if (op === "$nin") return !b.includes(a);
+        if (op === "$ne") return a !== b;
+        if (op === "$gte") return a >= b;
+        if (op === "$gt") return a > b;
+        if (op === "$lte") return a <= b;
+        throw Error(`Unknown query ${op}`);
+      });
+    return a === v;
+  });
+}
+export function db() {
+  const tables = {},
+    client = { entities: {}, fault: null };
+  let serial = 0;
+  client.entities = new Proxy(
+    {},
+    {
+      get(_, name) {
+        return {
+          async get(id) {
+            const r = (tables[name] || []).find((r) => r.id === id);
+            if (!r) throw Error(`${name} ${id} missing`);
+            return copy(r);
+          },
+          async create(data) {
+            const row = {
+              ...copy(data),
+              id: `${++serial}`.padStart(24, "0"),
+              created_date: new Date().toISOString(),
+            };
+            (tables[name] ||= []).push(row);
+            return copy(row);
+          },
+          async update(id, data) {
+            const row = (tables[name] || []).find((r) => r.id === id);
+            assert.ok(row);
+            Object.assign(row, copy(data));
+            return copy(row);
+          },
+          async updateMany(query, update) {
+            assert.equal(
+              typeof query.id,
+              "string",
+              "CAS must target one plain ID",
+            );
+            if (client.fault?.(name, query, update, "before"))
+              throw Error("injected failure");
+            let updated = 0;
+            for (const row of tables[name] || [])
+              if (matches(row, query)) {
+                Object.assign(row, copy(update.$set));
+                updated++;
+              }
+            if (client.fault?.(name, query, update, "after"))
+              throw Error("lost response");
+            return { updated, success: true };
+          },
+          async filter(query = {}, options = {}) {
+            const found = (tables[name] || []).filter((r) => matches(r, query));
+            return {
+              items: copy(found.slice(0, options.limit || 100)),
+              has_more: false,
+            };
+          },
+          async count(query) {
+            return (tables[name] || []).filter((r) => matches(r, query)).length;
+          },
+          async aggregate({ query = {}, sum = [] }) {
+            const rows = (tables[name] || []).filter((r) => matches(r, query));
+            return {
+              rows: [
+                Object.fromEntries(
+                  sum.map((k) => [
+                    `sum_${k}`,
+                    rows.reduce((s, r) => s + (r[k] || 0), 0),
+                  ]),
+                ),
+              ],
+              truncated: false,
+            };
+          },
+        };
+      },
+    },
+  );
+  client.rows = (name) => copy(tables[name] || []);
+  client.seed = (name, row) => (tables[name] ||= []).push(copy(row));
+  return client;
+}
