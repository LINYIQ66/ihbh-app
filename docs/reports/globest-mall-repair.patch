+    client,
+    "User",
+    t.to,
+    key,
+    { from: user.id, amount: t.amount },
+    (state) => ({
+      drafts: [
+        ledger(
+          state,
+          t.to,
+          t.amount,
+          "transfer_in",
+          key,
+          `来自 ${user.email} 的转账`,
+          user.id,
+        ),
+      ],
+    }),
+  );
+  await transact(
+    client,
+    "User",
+    user.id,
+    `settled:${t.key}`,
+    { key: t.key },
+    (state) => {
+      delete state.outgoing?.[t.key];
+      return {};
