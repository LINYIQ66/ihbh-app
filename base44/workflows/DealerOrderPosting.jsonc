{
  "name": "\u7ecf\u9500\u5546\u8ba2\u5355\u5b8c\u6210\u81ea\u52a8\u5165\u8d26",
  "description": "\u786e\u8ba4\u5b9e\u6536\u5e76\u5b8c\u6210\u51fa\u8d27\u8ba2\u5355\u540e\uff0c\u6309\u5df2\u9501\u5b9a\u7684\u8ba1\u7b97\u5feb\u7167\u53e0\u52a0\u5165\u8d26\uff0c\u5f52\u5c5e\u8ba2\u5355\u5b8c\u6210\u65e5\u7684\u6bcf\u65e5\u4e1a\u7ee9\uff0c\u91cd\u590d\u4e8b\u4ef6\u4e0d\u4f1a\u91cd\u590d\u8ba1\u8d26\u3002",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ShipOrder",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"completed\" and .trigger.old_data.status != \"completed\" and .trigger.data.kind != \"self_use\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dealer_order_posting",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_earnings": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "settleDealerOrder",
            "args": {
              "order_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u53e0\u52a0\u5165\u8d26",
            "description": "\u6309\u5b9e\u6536\u91d1\u989d\u5165\u8d26\u5206\u6da6\uff0c\u5e76\u5f52\u5c5e\u8ba2\u5355\u5b8c\u6210\u65e5"
          }
        }
      }
    ]
  }
}