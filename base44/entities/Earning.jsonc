{
  "name": "Earning",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct",
        "referral",
        "downline",
        "service",
        "settlement"
      ],
      "default": "direct"
    },
    "period": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "source_order_id": {
      "type": "string"
    },
    "posting_key": {
      "type": "string"
    },
    "posting_status": {
      "type": "string",
      "enum": [
        "pending",
        "posted"
      ],
      "default": "posted"
    },
    "component": {
      "type": "string",
      "enum": [
        "margin",
        "rebate",
        "referral",
        "downline",
        "share",
        "reward_cost"
      ]
    },
    "base_amount": {
      "type": "number"
    },
    "rate": {
      "type": "number"
    },
    "earned_day": {
      "type": "string",
      "format": "date",
      "description": "关联订单完成日期，按新加坡时间归属，重试入账不改变日期"
    },
    "transaction_status": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "payer_kind": {
      "type": "string",
      "description": "experience_hall：HBH体验馆居间费；dealer：经销商承担；headquarters：总部承担的合伙人回款奖励或旧版历史标识"
    },
    "payer_user_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "amount",
    "type"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.transaction_status": {
            "$ne": "prepared"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
