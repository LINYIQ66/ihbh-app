{
  "name": "Referral",
  "type": "object",
  "properties": {
    "inviter_user_id": {
      "type": "string"
    },
    "invitee_user_id": {
      "type": "string"
    },
    "invitee_email": {
      "type": "string"
    },
    "invite_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "member"
      ],
      "default": "registered"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "transaction_status": {
      "type": "string",
      "enum": [
        "prepared",
        "posted"
      ]
    }
  },
  "required": [
    "inviter_user_id",
    "invitee_user_id",
    "invitee_email",
    "invite_code",
    "status",
    "registered_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "$or": [
                {
                  "data.inviter_user_id": "{{user.id}}"
                },
                {
                  "data.invitee_user_id": "{{user.id}}"
                }
              ]
            },
            {
              "data.transaction_status": {
                "$ne": "prepared"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}
