{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "partner_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "business_name": {
      "type": "string"
    },
    "invite_code": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "referred_by_code": {
      "type": "string",
      "rls": {
        "write": false
      }
    },
    "display_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "address_line1": {
      "type": "string"
    },
    "address_line2": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "finance_state": {
      "type": "object",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": false
      }
    },
    "finance_version": {
      "type": "number",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": false
      }
    },
    "finance_pending": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": false
      }
    },
    "transaction_revision": {
      "type": "string",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "role"
  ]
}
