{
  "name": "DealerAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "partner",
        "official",
        "agent"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "parent_user_id": {
      "type": "string",
      "default": ""
    },
    "referrer_user_id": {
      "type": "string",
      "default": ""
    },
    "operation_token": {
      "type": "string",
      "default": ""
    },
    "operation_until": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "tier",
    "active"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}